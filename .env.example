# Copy to .env.local. Everything is optional: with no keys the app uses the
# offline "mock" provider, so you can run it without accounts or cost.

# Default provider for the Studio: mock | openai | google | bfl | qwen
IMAGE_PROVIDER=mock

# A provider appears in the Studio once its variable is set.
# (These adapters are stubs today. See src/lib/generation/providers/.)
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# BFL_API_KEY=
# QWEN_IMAGE_BASE_URL=
