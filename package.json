{
  "name": "ai-moma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "art:fetch": "node scripts/fetch-public-domain-art.mjs",
    "guides:voice": "node --no-warnings scripts/voice-guides.mjs",
    "meditation:voice": "node --no-warnings scripts/voice-meditation.mjs"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.33.2",
  "description": "An open-source virtual Museum of Modern Art: explore floors of art movements, learn, create with AI, and exhibit.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  }
}
